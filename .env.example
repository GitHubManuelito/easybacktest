DISCORD_BOT_TOKEN=
# Comma-separated role IDs allowed to run backtests.
DISCORD_ALLOWED_ROLE_IDS=ROLE_ID
# Comma-separated moderator role IDs; separate setting from allowed roles.
DISCORD_MODERATOR_ROLE_IDS=MODERATOR_ROLE_ID
# Comma-separated guild/server IDs where commands are registered.
DISCORD_GUILD_IDS=SERVER_ID
# Optional private moderator log channels, as SERVER_ID:CHANNEL_ID pairs.
DISCORD_MODERATOR_CHANNEL_IDS=SERVER_ID_1:CHANNEL_ID
